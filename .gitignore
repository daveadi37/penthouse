# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Environment. The anon key is safe to ship in a built bundle, but the
# file itself is per-machine and the VAPID public key changes with the
# project — so it is configured, not committed. See app/docs/DEPLOY.md.
.env
.env.*
!.env.example

# The service-role key and the VAPID private key live in Supabase Edge
# Function secrets and must never reach this repository. Nothing here
# should ever match, and if it does, something has gone wrong.
*.pem
*service-role*
*service_role*

# Snapshots of the migrations. A zip or a tarball of supabase/migrations
# duplicates the source of truth as an opaque binary and goes stale the
# first time a migration changes — which it did, silently carrying the
# broken storage file after that was fixed. Generate one when it is
# needed; do not commit it.
app/supabase/migrations.zip
app/supabase/*.zip
app/supabase/*.tar.gz

# Supabase CLI local state
app/supabase/.branches/
app/supabase/.temp/

# Editors and OS
.DS_Store
Thumbs.db
*.local
.idea/
.vscode/*
!.vscode/extensions.json
