# Copy to .env and fill in. Both are baked into the bundle at build time,
# not read when the app runs — change one and you must build and deploy
# again, or the app keeps using the old value. On Vercel they are set in
# the project's own settings and a redeploy is needed for the same
# reason. See SETUP.md step 6.
#
# With neither set, `npm run dev` runs on the seeded house, on the device
# only. That is a working state locally, and it is deliberately NOT
# reachable from a production build — a deployed site with no keys says
# it is not set up rather than letting anyone in.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → anon public
#
# Safe to commit to a built bundle: it grants nothing on its own, and
# every table is behind row-level security keyed to the signed-in
# account. It is still kept out of git because it is per-project.
VITE_SUPABASE_ANON_KEY=

# There is no third value. VITE_VAPID_PUBLIC_KEY used to be listed here
# and nothing in src/ has ever read it: there is no code that subscribes
# a device to push, no button to grant permission, and the cron that
# would drain the queue reads a setting nothing sets. Setting it would
# have changed nothing while looking like the feature was configured.
