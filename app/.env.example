# Copy to .env and fill in. All three are baked into the bundle at build
# time, not read when the app runs — change one and you must build and
# deploy again, or the app keeps using the old value.
#
# With none of these set the app runs on the seeded house, on the device
# only. That is a working state, not a broken one.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → anon public
#
# Safe to commit to a built bundle: it grants nothing on its own, and
# every table is behind row-level security keyed to the signed-in
# account. It is still kept out of git because it is per-project.
VITE_SUPABASE_ANON_KEY=

# The public half of a VAPID key pair, for push notifications.
# Generate once:  npx web-push generate-vapid-keys
#
# The PRIVATE half goes into Supabase → Project Settings → Edge
# Functions → Secrets as VAPID_PRIVATE_KEY. It must never appear in
# this file or anywhere else in this repository.
VITE_VAPID_PUBLIC_KEY=
